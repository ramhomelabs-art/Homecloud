# NexaDisk v2 Core Enterprise Server Configuration Example

PORT=5000
NODE_ENV=production

# Security JWT Key (Generate a 64+ char random string)
JWT_SECRET=replace-with-a-secure-random-jwt-secret-key-at-least-64-characters

# Agent Authentication Key
AGENT_KEY=replace-with-a-secure-agent-secret-key

# PostgreSQL Settings
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_DATABASE=nexadisk
DB_PORT=5432

# Redis Cache & BullMQ Queue Settings
REDIS_HOST=localhost
REDIS_PORT=6379
USE_IN_MEMORY_QUEUE=true

# Storage Settings ('local' or 's3')
STORAGE_TYPE=local
LOCAL_STORAGE_BASE=./uploads

# Client CORS Settings
CORS_ORIGIN=http://localhost:5000,http://localhost:5173

# Optional: GitHub Repository for OTA Updates
GITHUB_REPO=ramhomelabs-art/Homecloud
