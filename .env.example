# Environment Variables Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret (CHANGE THIS IN PRODUCTION!)
# Generate a new secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secret-key-here-change-in-production

# Database Configuration
DB_PATH=./database.sqlite

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Agent Security (Shared secret between Master and Agents)
# This key must match on both the Master and the Agent
AGENT_KEY=your-secure-agent-key-here
